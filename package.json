{
	"name": "good-enough-metronome",
	"version": "0.1.11",
	"private": true,
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"deploy": "pnpm build && wrangler deploy",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"eslint-plugin-svelte": "^3.24.1",
		"open-props": "^1.7.23",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.1",
		"tone": "^15.1.22",
		"tslib": "^2.9.1",
		"typescript": "^6.0.0",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"wrangler": "^4.160.0"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/lib/components/*",
		"#stores/*": "./src/lib/stores/*"
	}
}
